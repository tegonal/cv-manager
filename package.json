{
  "name": "cv-manager",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation node scripts/dev.mjs",
    "services:start": "docker compose -f docker-compose.dev.yml up -d --wait --remove-orphans",
    "services:stop": "docker compose -f docker-compose.dev.yml down --remove-orphans",
    "services:destroy": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans",
    "devsafe": "rm -rf .next && yarn run dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cross-env NODE_OPTIONS=--no-deprecation node .next/standalone/server.js",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types && yarn run check",
    "generate:importMap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importMap && yarn run check",
    "check": "eslint . --fix && prettier --write --log-level warn . && tsc --build --noEmit && echo '✓ All checks passed!'",
    "check:ci": "eslint . && prettier --check --log-level warn . && tsc --build --noEmit",
    "up": "yarn upgrade-interactive",
    "self-update": "yarn set version latest && yarn"
  },
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@react-pdf/renderer": "^4.9.0",
    "graphql": "^16.14.2",
    "hyphen": "^1.14.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "payload-oauth2": "^1.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf-tailwind": "^3.0.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@react-pdf/types": "^2.14.0",
    "@types/hyphen": "^1.14.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-perfectionist": "^4.15.1",
    "fallow": "^3.30.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3"
  },
  "packageManager": "yarn@4.18.1"
}
